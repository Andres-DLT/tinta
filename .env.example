# -----------------------------------------------------------------------------
# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Dashboard → Project Settings → API Keys / Data API).
# -----------------------------------------------------------------------------

# --- Next.js (navegador + servidor) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). La antigua "anon key" también funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# URL pública del servidor WebSocket de colaboración (wss:// en producción).
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
# Opcional: URL pública de la app (para los enlaces de confirmación de email).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Servidor de colaboración (server/index.ts) ------------------------------
# ¡SECRETA! Nunca la expongas al navegador. Clave secreta (sb_secret_...) o la
# antigua "service_role key".
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
# Puerto del servidor WebSocket (en PaaS se respeta también PORT).
COLLAB_PORT=1234
# Opcional: orígenes permitidos, separados por comas (recomendado en producción).
# COLLAB_ALLOWED_ORIGINS=http://localhost:3000,https://notas.midominio.com
